/* A09 Photography — custom CSS only; Flexbox and CSS Grid */
:root{--ink:#202522;--muted:#747b75;--cream:#f4f2ec;--paper:#fbfaf7;--green:#526b5b;--line:#dedfd8;--serif:"Playfair Display",Georgia,serif;--sans:"DM Sans",Arial,sans-serif}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.6}
a{color:inherit;text-decoration:none}
.site-header{height:82px;padding:0 7%;display:flex;align-items:center;justify-content:space-between;background:var(--paper);position:relative;z-index:5}
.brand{font-size:.78rem;letter-spacing:.16em;font-weight:700}.brand span{font-family:var(--serif);font-size:1.35rem;letter-spacing:0;margin-right:7px;color:var(--green)}
.nav{display:flex;align-items:center;gap:34px;font-size:.83rem}.nav a{transition:color .25s ease}.nav a:hover,.nav a.active{color:var(--green)}
.nav-cta{border:1px solid var(--ink);padding:10px 18px}.menu-toggle{display:none;background:none;border:0;font-size:1.5rem}
.hero{min-height:610px;background:linear-gradient(90deg,rgba(14,24,20,.76),rgba(14,24,20,.12)),url("https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2000&q=90") center 52%/cover;display:flex;align-items:center;padding:7%;position:relative;color:white}
.hero-content{max-width:650px}.eyebrow{font-size:.68rem;letter-spacing:.2em;font-weight:700;color:var(--green);margin:0 0 18px}.hero .eyebrow,.gallery-hero .eyebrow{color:#d5e0d5}
h1,h2,h3,p{margin-top:0}h1,h2{font-family:var(--serif);font-weight:600;line-height:1.08}h1{font-size:clamp(3.5rem,8vw,7rem);margin-bottom:22px}h1 em,h2 em{font-weight:600;color:#b9c9b9}
.hero-copy{font-size:1.05rem;max-width:430px;color:#e5e8e3;margin-bottom:32px}.button{display:inline-flex;gap:25px;align-items:center;padding:14px 21px;border:0;font:600 .82rem var(--sans);cursor:pointer;transition:transform .25s ease,background .25s ease}.button:hover{transform:translateY(-3px)}.button-light{background:var(--paper);color:var(--ink)}.button-dark{background:var(--green);color:white}.button-dark:hover{background:#3f5748}
.hero-credit{position:absolute;right:7%;bottom:30px;font-size:.62rem;letter-spacing:.17em}
.section-wrap{padding:100px 9%}.intro{display:grid;grid-template-columns:1fr 1fr;gap:10%;align-items:center}.intro h2,.contact h2{font-size:clamp(2.5rem,5vw,4.5rem);margin:0}.intro h2 em,.contact h2 em{color:var(--green)}.intro-text{color:var(--muted);max-width:480px;font-size:1rem}
.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:34px}.section-heading h2,.gallery-toolbar h2{font-size:2.4rem;margin:0}.text-link{font-size:.8rem;border-bottom:1px solid var(--green);padding-bottom:5px}
.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.photo-card img{width:100%;height:360px;object-fit:cover;display:block;transition:transform .45s ease}.photo-card{overflow:hidden}.photo-card img:hover{transform:scale(1.035)}.photo-caption{display:flex;justify-content:space-between;padding:17px 0}.photo-caption h3{font:600 1.25rem var(--serif);margin:0 0 3px}.photo-caption p,.photo-caption span{font-size:.72rem;color:var(--muted);margin:0}.quote-band{background:var(--green);color:white;text-align:center;padding:75px 15%}.quote-band p{font:italic 1.7rem var(--serif);margin-bottom:12px}.quote-band span{font-size:.75rem;color:#d5e0d5}
.contact{display:grid;grid-template-columns:.8fr 1.2fr;gap:12%;background:var(--cream)}.contact-copy>p:not(.eyebrow){color:var(--muted);max-width:350px;margin-top:25px}.small-note{font-size:.75rem}.enquiry-form{display:grid;grid-template-columns:1fr 1fr;gap:10px 16px}.enquiry-form label{font-size:.76rem;font-weight:600;align-self:end}.enquiry-form input,.enquiry-form select,.enquiry-form textarea{width:100%;padding:13px;border:1px solid #d5d8d0;background:var(--paper);font: .85rem var(--sans);color:var(--ink);border-radius:0}.enquiry-form input:focus,.enquiry-form select:focus,.enquiry-form textarea:focus{outline:2px solid var(--green);outline-offset:1px}.enquiry-form textarea,.enquiry-form button,.form-message{grid-column:1/-1}.enquiry-form button{justify-self:start;margin-top:8px}.form-message{font-size:.83rem;color:var(--green);margin:5px 0 0}.footer{padding:30px 7%;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:.72rem;color:var(--muted)}.brand-footer{color:var(--ink)}.footer p{margin:0}
.gallery-hero{background:var(--green);color:white;padding:100px 9% 90px}.gallery-hero h1{font-size:clamp(3.5rem,7vw,6rem);margin-bottom:20px}.gallery-hero>p:last-child{max-width:500px;color:#e1e8e1}.gallery-section{padding-top:70px}.gallery-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px;gap:20px}.filter-label{display:flex;align-items:center;gap:12px;font-size:.8rem}.filter-label select{padding:10px;border:1px solid var(--line);background:white;font:inherit}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:35px 22px}.gallery-item img{width:100%;height:300px;object-fit:cover;display:block}.gallery-item>div{padding:15px 0}.gallery-item span{font-size:.62rem;letter-spacing:.14em;color:var(--green);font-weight:700}.gallery-item h3{font:600 1.4rem var(--serif);margin:7px 0}.gallery-item p{font-size:.82rem;color:var(--muted);margin:0}
@media(max-width:900px){.section-wrap{padding:75px 6%}.hero{min-height:560px}.photo-grid,.gallery-grid{grid-template-columns:repeat(2,1fr)}.contact{gap:7%}.intro{gap:6%}}
@media(max-width:600px){.site-header{height:70px;padding:0 6%}.menu-toggle{display:block}.nav{display:none;position:absolute;top:70px;left:0;right:0;background:var(--paper);padding:22px 6%;flex-direction:column;align-items:flex-start;gap:18px;border-top:1px solid var(--line)}.nav.open{display:flex}.hero{min-height:570px;padding:8% 6%;background-position:58% center}.hero-credit{left:6%;right:auto;font-size:.55rem}.intro,.contact{grid-template-columns:1fr;gap:28px}.section-wrap{padding:65px 6%}.section-heading,.gallery-toolbar{align-items:flex-start;flex-direction:column;gap:16px}.photo-grid,.gallery-grid{grid-template-columns:1fr}.photo-card img{height:330px}.quote-band{padding:60px 8%}.quote-band p{font-size:1.35rem}.enquiry-form{grid-template-columns:1fr}.enquiry-form label{margin-top:6px}.enquiry-form textarea,.enquiry-form button,.form-message{grid-column:auto}.footer{padding:25px 6%;align-items:flex-start;flex-direction:column}.gallery-hero{padding:75px 6%}.gallery-item img{height:280px}}

/* Accessible responsive service table */
.table-wrap{overflow-x:auto}
.packages table{width:100%;border-collapse:collapse;background:white;font-size:.86rem}
.packages caption{text-align:left;color:var(--muted);font-size:.75rem;padding:0 0 12px}
.packages th,.packages td{text-align:left;padding:15px;border-bottom:1px solid var(--line)}
.packages th{background:var(--green);color:white;font-weight:600}
.packages tr:hover td{background:var(--cream)}
